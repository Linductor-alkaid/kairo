build/
build_*/
dist/
cmake-build-*/
output/
build*/

# 编译输出
*.o
*.obj
*.exe
*.out
*.app
*.dll
*.so
*.dylib
*.a
*.lib

# CMake生成文件
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake

!cmake/
!cmake/CompilerWarnings.cmake
!cmake/Sanitizers.cmake
!cmake/kairoConfig.cmake
!cmake/Coverage.cmake
# CR-084 安装树冒烟测试脚本（ctest install_headers_smoke 的 -P 入口）
!tests/install_headers_smoke.cmake

# IDE配置文件
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Visual Studio
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates

# 临时文件和日志
logs/
*.log
*.tmp
*.temp
*.bak
*.cache
*.wav

# 调试文件
*.pdb
*.ilk

# claude
.claude/
.codex/
.agents/

# 用户配置
ai_service_config.json
AGENTS.md

# 不忽略第三方库
